{
  "name": "findout-desktop",
  "productName": "Find Out",
  "version": "1.0.0",
  "description": "Find Out — Rastreamento tátil inteligente (app desktop)",
  "main": "src/main.js",
  "author": "Find Out",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "br.com.findout.desktop",
    "productName": "Find Out",
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.png"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.utilities",
      "icon": "assets/icon.png"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility",
      "icon": "assets/icon.png"
    }
  },
  "dependencies": {
    "bootstrap": "^5.3.8",
    "dotenv": "^16.4.5",
    "mysql2": "^3.24.6"
  },
  "keywords": [],
  "type": "commonjs"
}
