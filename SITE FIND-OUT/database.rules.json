{
  "rules": {
    ".read": false,
    ".write": false,
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        "profile": {
          ".validate": "newData.hasChildren(['username','email','phone'])"
        },
        "bracelet": {
          ".validate": "newData.hasChildren(['id'])",
          "id": { ".validate": "newData.isString() && newData.val().length >= 4 && newData.val().length <= 32" },
          "battery": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100" },
          "lat": { ".validate": "newData.isNumber() && newData.val() >= -90 && newData.val() <= 90" },
          "lng": { ".validate": "newData.isNumber() && newData.val() >= -180 && newData.val() <= 180" },
          "lastSeen": { ".validate": "newData.isNumber()" },
          "$other": { ".validate": true }
        },
        "tags": {
          "$tagId": {
            ".validate": "newData.hasChildren(['name'])",
            "name": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 40" },
            "battery": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100" },
            "lat": { ".validate": "newData.isNumber() && newData.val() >= -90 && newData.val() <= 90" },
            "lng": { ".validate": "newData.isNumber() && newData.val() >= -180 && newData.val() <= 180" },
            "lastSeen": { ".validate": "newData.isNumber()" },
            "$other": { ".validate": true }
          }
        },
        "alerts": { ".validate": true }
      }
    },
    "logins": {
      "$key": {
        ".read": true,
        ".write": "auth != null && (!data.exists() || data.child('uid').val() === auth.uid)",
        ".validate": "newData.hasChildren(['email','uid']) && newData.child('uid').val() === auth.uid"
      }
    }
  }
}
